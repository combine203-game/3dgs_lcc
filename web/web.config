<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- SOG / 碰撞网格等二进制资产的 MIME 映射。
         IIS 默认不认识这些扩展名，未注册时会返回 404.3(Not Found)，
         表现就是浏览器控制台满屏 404。 -->
    <staticContent>
      <remove fileExtension=".sog" />
      <mimeMap fileExtension=".sog" mimeType="application/octet-stream" />
      <remove fileExtension=".ply" />
      <mimeMap fileExtension=".ply" mimeType="application/octet-stream" />
      <remove fileExtension=".btree" />
      <mimeMap fileExtension=".btree" mimeType="application/octet-stream" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".wasm" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <add name="Access-Control-Allow-Origin" value="*" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
